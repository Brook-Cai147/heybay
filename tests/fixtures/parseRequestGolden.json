    { "id": "c09", "kind": "normal", "text": "想打听一下伦敦哪家中国超市便宜一点", "expect": { "category": "inquiry", "rewardType": "free" } },
    { "id": "c10", "kind": "normal", "text": "谁知道现在这个点希思罗到市区还有地铁吗，比较急", "expect": { "category": "inquiry", "timing": "instant" } },
