# 复制为 .env 后填入真实值。.env 已被 .gitignore 排除，绝不提交。
# 云函数侧通过环境变量读取，小程序端永不接触这些值。

# ---- AI 模型 ----
# 主力模型（便宜档，用于需求单解析、机审、破冰翻译等高频短文本）
AI_PRIMARY_BASE_URL=
AI_PRIMARY_API_KEY=
AI_PRIMARY_MODEL=

# 长输出模型（行程生成、小红书文案，可与主力相同）
AI_LONG_BASE_URL=
AI_LONG_API_KEY=
AI_LONG_MODEL=

# ---- 微信 ----
# AppSecret 仅云函数使用，用于内容安全接口与订阅消息
WX_APPSECRET=

# ---- 运维 ----
# 管理员 openid 白名单，逗号分隔（也可放在 configs 集合里动态管理）
ADMIN_OPENIDS=
