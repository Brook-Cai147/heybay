# 复制为 .env 后填入真实值。.env 已被 .gitignore 排除，绝不提交。
# 云函数侧通过环境变量读取，小程序端永不接触这些值。

# ---- AI 模型 ----
# 只讲 OpenAI 兼容协议（/chat/completions）。DeepSeek 官方、阿里云百炼兼容模式、
# 公司内部 OneAPI 网关都用同一套变量接入，换供应商不改代码。
# BASE_URL 填到 /v1 即可，例：https://api.deepseek.com/v1

# 主力模型（便宜档，用于需求单解析、机审、破冰翻译等高频短文本）
AI_PRIMARY_BASE_URL=
AI_PRIMARY_API_KEY=
AI_PRIMARY_MODEL=
# 单价（人民币元 / 百万 token），只用于 aiLogs 记账，不影响调用；不填则成本记 0
AI_PRIMARY_PRICE_IN=
AI_PRIMARY_PRICE_OUT=

# 长输出模型（行程生成、小红书文案，可与主力相同；不配则自动回落到主力）
AI_LONG_BASE_URL=
AI_LONG_API_KEY=
AI_LONG_MODEL=
AI_LONG_PRICE_IN=
AI_LONG_PRICE_OUT=

# 供应商不认 response_format: json_object 时填 off 关掉
#（此时只靠 Prompt 内强约束 + M2-02 校验器兜底）
AI_JSON_MODE=

# 厂商专有的请求体字段，JSON 字符串，合并进请求体。代码里不写厂商专有格式，一律走这里。
# DeepSeek V4 必填：思考模式默认开着，思维链按输出 token 计费，
# 对「一句话转结构化字段」这类任务纯属更慢更贵。关掉的写法：
# AI_EXTRA_BODY={"thinking":{"type":"disabled"}}
AI_EXTRA_BODY=

# ---- 微信 ----
# AppSecret 仅云函数使用，用于内容安全接口与订阅消息
WX_APPSECRET=

# ---- 运维 ----
# 管理员 openid 白名单，逗号分隔（也可放在 configs 集合里动态管理）
ADMIN_OPENIDS=
