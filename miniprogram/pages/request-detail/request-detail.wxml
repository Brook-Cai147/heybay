<view class="page">
  <view class="loading" wx:if="{{loading}}">加载中…</view>

  <view class="card err-card" wx:if="{{error && !request}}">
    <text class="err">{{error}}</text>
  </view>

  <block wx:if="{{request && !loading}}">
    <!-- 需求本体 -->
    <view class="card">
      <view class="line1">
        <text class="category">{{categoryLabel}}</text>
        <text class="status">{{statusLabel}}</text>
      </view>
      <text class="title">{{request.title}}</text>
      <text class="detail">{{request.detail}}</text>

      <view class="row"><text class="label">时效</text><text class="value">{{timingLabel}} · {{expireText}} 前有效</text></view>
      <view class="row"><text class="label">报酬</text><text class="value">{{rewardLabel}}</text></view>
      <view class="row"><text class="label">地点</text><text class="value">{{request.area || '未填'}}</text></view>
      <view class="row" wx:if="{{request.headcount}}"><text class="label">需要人数</text><text class="value">{{request.headcount}} 人</text></view>
      <view class="row"><text class="label">已有响应</text><text class="value">{{request.responseCount}} 人</text></view>

      <view class="owner-line">
        <text class="owner">{{request.ownerNickName || '匿名'}}</text>
        <text class="trust">新面孔</text>
        <text class="tag" wx:if="{{request.preference.sameGenderOnly}}">仅同性响应</text>
        <text class="tag test" wx:if="{{request.isTest}}">联调</text>
      </view>
    </view>

    <!-- 视角一：其他人 → 响应入口 -->
    <view class="card" wx:if="{{actions.canRespond}}">
      <text class="card-title">我可以帮</text>
      <textarea
        class="area-input"
        value="{{pitch}}"
        bindinput="onPitchInput"
        placeholder="一句话说明你为什么合适，比如：我住附近，常去那家店"
        maxlength="100"
        auto-height
      />
      <view class="row" wx:if="{{needQuote}}">
        <text class="label">我的报价</text>
        <input class="input" type="digit" value="{{quote}}" bindinput="onQuoteInput" placeholder="线下结算，平台不代收" />
      </view>
      <button class="primary" loading="{{submitting}}" bindtap="onSubmitResponse">响应这条需求</button>
    </view>

    <view class="card" wx:if="{{actions.showRespondedHint}}">
      <text class="card-title">你已响应</text>
      <text class="tip">等需求方选定就好。别人的自荐内容不会展示给你。</text>
    </view>

    <!-- 达成共识后互相下发联系方式（D-36）。这是双方唯一的联系渠道，私信属 M3 -->
    <view class="card contact-card" wx:if="{{actions.canSeeContact}}">
      <text class="card-title">对方的联系方式</text>
      <block wx:if="{{peerContact}}">
        <view class="row">
          <text class="label">{{peerContactLabel}}</text>
          <text class="value contact-value">{{peerContact.value}}</text>
          <text class="link" bindtap="onCopyContact">复制</text>
        </view>
        <text class="tip">{{peerNickName || '对方'}} 也看到了你的联系方式。见面前请回看上面那四条安全提示；不要提前转账。</text>
      </block>
      <text class="warn" wx:if="{{!peerContact}}">对方还没填联系方式，可以在这条需求里等一等，或者撤销选定换人。</text>
    </view>

    <!-- 视角二：需求方 → 响应列表与选定 -->
    <view class="card" wx:if="{{isOwner}}">
      <text class="card-title">响应者（{{responses.length}}）</text>
      <text class="tip" wx:if="{{responses.length === 0}}">还没有人响应。即时型需求通常前 30 分钟最活跃。</text>

      <view class="responder" wx:for="{{responses}}" wx:key="_id">
        <view class="responder-head">
          <text class="responder-name">{{item.responderNickName || '匿名'}}</text>
          <text class="trust">{{item.trustLabel}}</text>
          <text class="tag" wx:if="{{item.selected}}">已选定</text>
        </view>
        <text class="pitch" wx:if="{{item.pitch}}">{{item.pitch}}</text>
        <text class="quote" wx:if="{{item.quote}}">报价 {{item.quote}}</text>
        <text class="evidence" wx:if="{{item.responderDoneCount}}">完成过 {{item.responderDoneCount}} 单</text>

        <button
          class="select-btn"
          wx:if="{{actions.canSelect}}"
          data-id="{{item._id}}"
          bindtap="onTapSelect"
        >选定他</button>
      </view>

      <!-- 撤销选定（D-35）：约不上就换人，不必取消整条需求 -->
      <block wx:if="{{actions.canUnselect}}">
        <button class="ghost" loading="{{unselecting}}" bindtap="onUnselect">撤销选定，重新挑人</button>
        <text class="tip">已经交换过的联系方式收不回；撤销次数会被记录，但信用主要看双方真实评价。</text>
        <text class="tip" wx:if="{{request.reselectCount}}">这条需求已撤销过 {{request.reselectCount}} 次。</text>
      </block>
    </view>

    <!-- 视角二·补充：定向邀请（M2-14）。AI 起草 → 你勾选 → 你点发，三步都在这一张卡里 -->
    <view class="card" wx:if="{{canInvite}}">
      <text class="card-title">让 AI 帮你想想能问谁</text>
      <view class="row" wx:if="{{inviteLevelName}}">
        <text class="label">当前档位</text>
        <text class="value">{{inviteLevelName}}</text>
      </view>
      <text class="tip" wx:if="{{!inviteTargets.length}}">AI 只出名单和文案，发给谁由你勾。一条都不会自己发出去。</text>
      <text class="tip" wx:if="{{inviteDegraded}}">这次模型没帮上忙，文案用的是按需求单套出来的模板，你可以照原样发。</text>
      <text class="warn" wx:if="{{inviteMessage}}">{{inviteMessage}}</text>
      <text class="tip" wx:if="{{invitePoolText}}">{{invitePoolText}}</text>

      <view class="invite" wx:for="{{inviteTargets}}" wx:key="openid">
        <view class="invite-head" data-index="{{index}}" bindtap="onToggleTarget">
          <text class="checkbox {{item.checked ? 'on' : ''}}">{{item.checked ? '✓' : ''}}</text>
          <text class="responder-name">{{item.user.nickName || '这位用户'}}</text>
          <text class="tag" wx:if="{{item.textSource === 'template'}}">模板文案</text>
        </view>
        <text class="pitch">{{item.text}}</text>
        <text class="evidence">依据：{{item.reason}}</text>
      </view>

      <button
        class="ghost"
        wx:if="{{!inviteTargets.length}}"
        loading="{{inviteDrafting}}"
        bindtap="onDraftInvite"
      >找人并起草邀请</button>

      <block wx:if="{{inviteTargets.length}}">
        <button
          class="primary"
          wx:if="{{inviteCanSend}}"
          loading="{{inviteSending}}"
          bindtap="onSendInvites"
        >发出勾选的邀请</button>
        <text class="warn" wx:if="{{!inviteCanSend}}">你现在是「{{inviteLevelName}}」档，AI 只出建议不代发。想让它帮你发，去小螺那页切到「一键代发」。</text>
      </block>
    </view>

    <!-- L1→L2 的一次性询问（D-14）：只在邀请真的换来过响应之后问，而且只问一次 -->
    <view class="card" wx:if="{{l2Prompt}}">
      <text class="card-title">要不要更省事一点</text>
      <text class="tip">{{l2Prompt.question}}</text>
      <text class="tip">{{l2Prompt.note}}</text>
      <view class="row">
        <button class="ghost" size="mini" data-accepted="yes" bindtap="onAnswerL2">以后自动发</button>
        <button class="ghost" size="mini" data-accepted="no" bindtap="onAnswerL2">还是我自己勾</button>
      </view>
    </view>

    <!-- 双方确认完成 -->
    <view class="card" wx:if="{{actions.canConfirmDone || actions.waitingForPeer}}">
      <text class="card-title">确认完成</text>
      <view class="row">
        <text class="label">需求方</text>
        <text class="value">{{doneConfirm.owner ? '已确认' : '未确认'}}</text>
      </view>
      <view class="row">
        <text class="label">响应者</text>
        <text class="value">{{doneConfirm.responder ? '已确认' : '未确认'}}</text>
      </view>
      <button class="primary" wx:if="{{actions.canConfirmDone}}" bindtap="onConfirmDone">我这边已完成</button>
      <text class="tip" wx:if="{{actions.waitingForPeer}}">你已确认，等对方确认。</text>
      <text class="tip">两边都确认后这条需求才算完成 —— 一方说完成、另一方没到场的情况下，不该算成一次成功。</text>
    </view>

    <view class="card done-card" wx:if="{{request.status === STATUS_DONE}}">
      <text class="card-title">已完成</text>
      <text class="tip">双向评价属 M3；私信与约定单卡片属 M3，本版本没有。</text>
    </view>

    <!-- 取消 -->
    <view class="card" wx:if="{{actions.canCancel}}">
      <text class="link danger" bindtap="onCancel">取消这条需求</text>
      <text class="tip">取消会记录取消方与次数（PRD 4.1 规则 3）；信用分主要看双方真实评价（M3）。</text>
    </view>

    <view class="card">
      <text class="link" bindtap="goSquare">回需求广场</text>
    </view>
  </block>

  <!-- 安全提示卡：选定前强制展示一次（PRD 4.5） -->
  <view class="mask" wx:if="{{safetyVisible}}">
    <view class="sheet">
      <text class="sheet-title">见面前请先看这四条</text>
      <view class="tip-item" wx:for="{{safetyTips}}" wx:key="*this">
        <text class="dot">·</text><text class="tip-text">{{item}}</text>
      </view>
      <text class="sheet-note">选定之后你们会互相看到联系方式，自己去约。约不上可以撤销选定重新挑人，但已经看到的联系方式收不回。</text>
      <button class="primary" loading="{{selecting}}" bindtap="onConfirmSelect">我已了解，继续选定</button>
      <text class="link" bindtap="onCancelSelect">再想想</text>
    </view>
  </view>
</view>
