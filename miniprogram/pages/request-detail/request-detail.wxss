.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 80rpx;
  background: #f7f8fa;
  box-sizing: border-box;
}

.loading {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.line1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.category {
  font-size: 22rpx;
  color: #1296db;
  background: #eaf6fd;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.status {
  font-size: 24rpx;
  color: #1296db;
}

.title {
  margin-top: 16rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.4;
}

.detail {
  margin: 16rpx 0 8rpx;
  font-size: 28rpx;
  color: #444;
  line-height: 1.7;
}

.row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}

.label {
  width: 180rpx;
  font-size: 26rpx;
  color: #888;
}

.value {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.owner-line {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.owner {
  font-size: 26rpx;
  color: #555;
}

.trust,
.tag {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #888;
  background: #f2f3f5;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}

.tag.test {
  color: #b26a00;
  background: #fff8e6;
}

.area-input {
  width: 100%;
  min-height: 140rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.7;
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.primary {
  margin-top: 24rpx;
  background: #1296db;
  color: #fff;
  font-size: 30rpx;
  border-radius: 44rpx;
}

.tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.7;
}

.responder {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
  display: flex;
  flex-direction: column;
}

.responder-head {
  display: flex;
  align-items: center;
}

.responder-name {
  font-size: 28rpx;
  color: #1a1a1a;
}

.pitch {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #444;
  line-height: 1.6;
}

.quote,
.evidence {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #888;
}

.select-btn {
  margin-top: 20rpx;
  align-self: flex-start;
  background: #1296db;
  color: #fff;
  font-size: 26rpx;
  border-radius: 32rpx;
  padding: 0 48rpx;
  line-height: 64rpx;
}

.done-card {
  border: 1rpx solid #d8f0dd;
}

/* 联系方式卡：给一点强调色，它是达成共识之后最该被看见的东西（D-36） */
.contact-card {
  border: 1rpx solid #cfe9f7;
  background: #fbfeff;
}

.contact-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.ghost {
  margin-top: 24rpx;
  align-self: flex-start;
  background: #fff;
  color: #1296db;
  font-size: 26rpx;
  border: 1rpx solid #1296db;
  border-radius: 32rpx;
  padding: 0 40rpx;
  line-height: 64rpx;
}

.warn {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #f37b1d;
  line-height: 1.7;
}

.link {
  font-size: 26rpx;
  color: #1296db;
}

.link.danger {
  color: #e54d42;
}

.err-card {
  border: 1rpx solid #f8d7d5;
}

.err {
  font-size: 26rpx;
  color: #e54d42;
}

/* 定向邀请（M2-14）：勾选框做大一点，误触发出去的代价是骚扰到别人 */
.invite {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
  display: flex;
  flex-direction: column;
}

.invite-head {
  display: flex;
  align-items: center;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  line-height: 40rpx;
  text-align: center;
  color: #ffffff;
  background: #ffffff;
  border: 1rpx solid #ccc;
  border-radius: 8rpx;
}

.checkbox.on {
  background: #1296db;
  border-color: #1296db;
}


.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.sheet {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 40rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 24rpx;
}

.tip-item {
  width: 100%;
  display: flex;
  align-items: flex-start;
  padding: 8rpx 0;
}

.dot {
  font-size: 28rpx;
  color: #1296db;
  padding-right: 12rpx;
}

.tip-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  line-height: 1.7;
}

.sheet-note {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #e54d42;
  text-align: center;
}
