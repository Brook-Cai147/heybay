.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 80rpx;
  background: #f7f8fa;
  box-sizing: border-box;
}

.loading {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  flex: 1;
}

.status {
  font-size: 24rpx;
  color: #1296db;
  padding-left: 16rpx;
}

.detail {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #444;
  line-height: 1.7;
}

.row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}

.label {
  width: 180rpx;
  font-size: 26rpx;
  color: #888;
}

.value {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.milestone {
  font-size: 24rpx;
  color: #999;
  line-height: 1.7;
}

.link {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #1296db;
}

.err-card {
  border: 1rpx solid #f8d7d5;
}

.err {
  font-size: 26rpx;
  color: #e54d42;
}
