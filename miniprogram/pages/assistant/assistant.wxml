<view class="page">
  <!-- 自主性档位（M2-14 / D-14）：当前档位与理由常驻，随时可改 -->
  <view class="levelbar" wx:if="{{level}}">
    <text class="levelbar-name">{{levelName}}</text>
    <text class="levelbar-reason">{{levelReason}}</text>
    <text class="levelbar-link" bindtap="onToggleLadder">换一档</text>
  </view>

  <scroll-view class="stream" scroll-y scroll-into-view="{{scrollInto}}" scroll-with-animation>
    <view
      class="row {{item.role === 'me' ? 'row-me' : ''}}"
      wx:for="{{messages}}"
      wx:key="id"
      id="{{item.id}}"
    >
      <view class="bubble {{item.role === 'me' ? 'mine' : ''}}">
        <text class="badge" wx:if="{{item.aiAssisted}}">AI 协助</text>
        <text class="text">{{item.text}}</text>

        <!-- 兜底作答的来源标注（PRD 5.4：答案必须能追到出处） -->
        <view class="sources" wx:if="{{item.sources.length}}">
          <text class="sources-title">出处</text>
          <view class="source" wx:for="{{item.sources}}" wx:for-item="src" wx:key="refId">
            <text class="source-ref">{{src.sourceRef || src.refId}}</text>
            <text class="source-excerpt">{{src.excerpt}}</text>
          </view>
        </view>

        <!-- 落地清单 -->
        <view class="groups" wx:if="{{item.groups.length}}">
          <view class="group" wx:for="{{item.groups}}" wx:for-item="g" wx:key="group">
            <text class="group-title">{{g.group}}</text>
            <view class="citem" wx:for="{{g.items}}" wx:for-item="it" wx:key="text">
              <text class="citem-text">{{it.text}}</text>
              <text class="citem-note" wx:if="{{it.note}}">{{it.note}}</text>
            </view>
          </view>
        </view>

        <!-- 可解释推荐：理由旁边一定要有依据字段 -->
        <view class="cands" wx:if="{{item.candidates.length}}">
          <view class="cand" wx:for="{{item.candidates}}" wx:for-item="c" wx:key="score">
            <text class="cand-name">{{c.user.nickName || '这位用户'}}</text>
            <text class="cand-reason">{{c.reason}}</text>
            <view class="cand-evidence">
              <text class="tag" wx:for="{{c.evidence}}" wx:for-item="ev" wx:key="field">{{ev.text}}</text>
            </view>
          </view>
        </view>

        <!-- 草稿：能问的就在对话里问，问不了的才交给发布页 -->
        <view class="draft-ops" wx:if="{{item.kind === 'draft'}}">
          <text class="draft-missing" wx:if="{{item.rewardOptions.length}}">这次的报酬怎么算？选一个我就发。</text>
          <text class="draft-missing" wx:if="{{item.handoff}}">还差几项才能发出去，去表单补齐更快。</text>

          <block wx:if="{{item.rewardOptions.length}}">
            <button
              class="ghost"
              size="mini"
              wx:for="{{item.rewardOptions}}"
              wx:for-item="rw"
              wx:key="value"
              data-value="{{rw.value}}"
              data-label="{{rw.label}}"
              bindtap="onPickReward"
            >{{rw.label}}</button>
            <button
              class="ghost"
              size="mini"
              data-label="{{item.rewardNeedsFormLabel}}"
              bindtap="onPickRewardForm"
            >{{item.rewardNeedsFormLabel}}（去表单填金额）</button>
          </block>

          <block wx:if="{{item.needsConfirm}}">
            <button class="primary" size="mini" bindtap="onConfirmDraft">确认发布</button>
            <button class="ghost" size="mini" bindtap="onDropDraft">先不发</button>
          </block>

          <button class="ghost" size="mini" wx:if="{{item.handoff}}" bindtap="onHandoffPublish">去表单补齐</button>
        </view>

        <!-- 认不出意图时的三个按钮 -->
        <view class="opts" wx:if="{{item.options.length}}">
          <button
            class="ghost"
            size="mini"
            wx:for="{{item.options}}"
            wx:for-item="opt"
            wx:key="intent"
            data-intent="{{opt.intent}}"
            data-label="{{opt.label}}"
            bindtap="onPickOption"
          >{{opt.label}}</button>
        </view>

        <!-- 落地清单缺的出行类型 -->
        <view class="opts" wx:if="{{item.travelTypeOptions.length}}">
          <button
            class="ghost"
            size="mini"
            wx:for="{{item.travelTypeOptions}}"
            wx:for-item="tt"
            wx:key="*this"
            data-value="{{tt}}"
            bindtap="onPickTravelType"
          >{{tt}}</button>
        </view>

        <view class="draft-ops" wx:if="{{item.kind === 'created' && item.requestId}}">
          <button class="primary" size="mini" data-id="{{item.requestId}}" bindtap="onOpenRequest">看看这条单</button>
        </view>

        <view class="draft-ops" wx:if="{{item.kind === 'soft_fail' && item.missingFields.length}}">
          <button class="ghost" size="mini" bindtap="onHandoffPublish">去表单补齐</button>
        </view>
      </view>
    </view>

    <view class="row" wx:if="{{sending}}">
      <view class="bubble"><text class="text">小螺在想…</text></view>
    </view>
  </scroll-view>

  <view class="composer">
    <input
      class="input"
      value="{{input}}"
      placeholder="说一句你想做的事"
      confirm-type="send"
      bindinput="onInput"
      bindconfirm="onSend"
    />
    <button class="send" size="mini" loading="{{sending}}" bindtap="onSend">发送</button>
  </view>

  <!-- 档位说明：每档「能做什么 / 不能做什么」都要列出来，用户才谈得上"选择" -->
  <view class="mask" wx:if="{{ladderVisible}}" bindtap="onToggleLadder">
    <view class="sheet" catchtap="noop">
      <text class="sheet-title">AI 能替你做到哪一步，你说</text>

      <view class="lv {{item.current ? 'lv-current' : ''}}" wx:for="{{ladder}}" wx:key="level">
        <view class="lv-head">
          <text class="lv-name">{{item.name}}</text>
          <text class="lv-flag" wx:if="{{item.current}}">当前</text>
          <text class="lv-flag off" wx:if="{{!item.selectable}}">{{item.defaultFor}}</text>
        </view>
        <text class="lv-summary">{{item.summary}}</text>
        <text class="lv-line" wx:for="{{item.can}}" wx:for-item="c" wx:key="*this">会：{{c}}</text>
        <text class="lv-line no" wx:for="{{item.cannot}}" wx:for-item="n" wx:key="*this">{{n}}</text>
        <button
          class="ghost"
          size="mini"
          wx:if="{{item.selectable && !item.current}}"
          loading="{{switching}}"
          data-level="{{item.level}}"
          catchtap="onPickLevel"
        >切到这一档</button>
      </view>

      <!-- 明确不做的那一档：理由要给用户看，不是只写在决策日志里 -->
      <view class="lv lv-never" wx:if="{{never}}">
        <view class="lv-head">
          <text class="lv-name">{{never.name}}</text>
          <text class="lv-flag off">永不实现</text>
        </view>
        <text class="lv-summary">{{never.whyNever}}</text>
      </view>

      <text class="lv-close" bindtap="onToggleLadder">知道了</text>
    </view>
  </view>
</view>
