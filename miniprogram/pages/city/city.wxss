.placeholder {
  min-height: 100vh;
  padding: 200rpx 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #f7f8fa;
  box-sizing: border-box;
}

.ph-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.ph-tip {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #999;
  text-align: center;
  line-height: 1.7;
}
