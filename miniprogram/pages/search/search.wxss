/* 搜索页面样式 */
.search-page {
  width: 100%;
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 搜索头部 */
.search-header {
  background-color: #ffffff;
  padding: 15rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 100;
}

.search-input-container {
  display: flex;
  align-items: center;
  background-color: #f0f0f0;
  border-radius: 30rpx;
  padding: 10rpx 20rpx;
  flex: 1;
}

.search-icon {
  color: #999999;
  margin-right: 10rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #333333;
  padding: 5rpx 0;
}

.cancel-btn {
  margin-left: 20rpx;
  font-size: 26rpx;
  color: #1296db;
  cursor: pointer;
}

/* 搜索内容区 */
.search-content {
  padding: 20rpx;
}

/* 热搜词条区 */
.hot-search-section {
  margin-bottom: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
}

.clear-history {
  font-size: 24rpx;
  color: #999999;
  cursor: pointer;
}

.hot-tags {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.hot-tag {
  display: flex;
  align-items: center;
  padding: 15rpx;
  background-color: #ffffff;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
  cursor: pointer;
  transition: all 0.3s ease;
}

.hot-tag:hover {
  background-color: #f0f7ff;
}

.hot-tag-rank {
  width: 30rpx;
  height: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: bold;
  color: #ffffff;
  background-color: #ff6b6b;
  border-radius: 4rpx;
  margin-right: 15rpx;
}

.hot-tag:nth-child(2) .hot-tag-rank {
  background-color: #ff9e42;
}

.hot-tag:nth-child(3) .hot-tag-rank {
  background-color: #ffc842;
}

.hot-tag-text {
  font-size: 24rpx;
  color: #333333;
  flex: 1;
}

/* 历史搜索区 */
.history-section {
  margin-bottom: 30rpx;
}

.history-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.history-tag {
  padding: 10rpx 20rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
  cursor: pointer;
  transition: all 0.3s ease;
}

.history-tag:hover {
  background-color: #f0f7ff;
}

.history-tag-text {
  font-size: 24rpx;
  color: #666666;
}