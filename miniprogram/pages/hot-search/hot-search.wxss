.hot-search-page {
  width: 100%;
  min-height: 100vh;
  background-color: #f5f5f5;
}

.hot-search-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 100;
}

.hot-search-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.refresh-btn {
  font-size: 24rpx;
  color: #1296db;
  cursor: pointer;
}

.hot-search-list {
  padding: 20rpx;
}

.hot-search-item {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  padding: 20rpx;
  margin-bottom: 15rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  cursor: pointer;
  transition: all 0.3s ease;
}

.hot-search-item:hover {
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  transform: translateY(-2rpx);
}

.hot-rank {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  color: #999999;
  margin-right: 20rpx;
}

.hot-rank.top-rank {
  color: #ff6b6b;
}

.hot-content {
  flex: 1;
}

.hot-title {
  font-size: 26rpx;
  color: #333333;
  margin-bottom: 5rpx;
  display: block;
}

.hot-count {
  font-size: 20rpx;
  color: #999999;
}

.hot-icon {
  width: 24rpx;
  height: 24rpx;
  margin-left: 15rpx;
}