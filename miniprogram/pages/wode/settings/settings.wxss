/* 设置页面样式 */
.settings-container {
  width: 100%;
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f7ff 0%, #f8f9fa 100%);
  padding-bottom: 160rpx;
}

/* 设置列表 */
.settings-list {
  margin: 20rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(18, 150, 219, 0.1);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  overflow: hidden;
}

/* 设置条目 */
.settings-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid rgba(18, 150, 219, 0.1);
  cursor: pointer;
  transition: all 0.3s ease;
}

.settings-item:last-child {
  border-bottom: none;
}

.settings-item:hover {
  background: linear-gradient(135deg, #f5f7fa 0%, #e8f0fe 100%);
}

/* 左侧内容 */
.item-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.item-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.item-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #2c3e50;
}

/* 右侧内容 */
.item-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.item-desc {
  font-size: 22rpx;
  color: #a4b0be;
  max-width: 300rpx;
  text-align: right;
}

.arrow-icon {
  font-size: 40rpx;
  color: #a4b0be;
  font-weight: 300;
}

/* 退出登录条目 */
.logout-item {
  background: linear-gradient(135deg, #fff5f5 0%, #ffe8e8 100%);
}

.logout-item:hover {
  background: linear-gradient(135deg, #ffe8e8 0%, #ffd6d6 100%);
}

.logout-text {
  color: #ff4757;
  font-weight: 600;
}

/* 响应式调整 */
@media (max-width: 375px) {
  .settings-item {
    padding: 20rpx;
  }
  
  .item-icon {
    width: 40rpx;
    height: 40rpx;
  }
  
  .item-text {
    font-size: 26rpx;
  }
  
  .item-desc {
    font-size: 20rpx;
    max-width: 250rpx;
  }
  
  .arrow-icon {
    width: 20rpx;
    height: 20rpx;
  }
}

/* 动画效果 */
@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateX(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.settings-item {
  animation: slideIn 0.3s ease;
}

.settings-item:nth-child(1) {
  animation-delay: 0.05s;
}

.settings-item:nth-child(2) {
  animation-delay: 0.1s;
}

.settings-item:nth-child(3) {
  animation-delay: 0.15s;
}

.settings-item:nth-child(4) {
  animation-delay: 0.2s;
}

.settings-item:nth-child(5) {
  animation-delay: 0.25s;
}