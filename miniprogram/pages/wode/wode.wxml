<view class="wode-container">
  <!-- 头部个人信息区 -->
  <view class="header-section">
    <!-- 基础信息 -->
    <view class="basic-info">
      <view class="avatar-container">
        <image src="/images/profile.png" class="avatar"></image>
      </view>
      <view class="user-info">
        <view class="name-row">
          <text class="nickname">旅行者小A</text>
          <text class="gender">♀</text>
          <text class="city">伦敦</text>
        </view>
        <!-- 身份标签 -->
        <view class="tags">
          <view class="tag student">留学生</view>
          <view class="tag traveler">旅行者</view>
          <view class="tag expat">旅居</view>
        </view>
      </view>
      <view class="action-buttons">
        <view class="edit-btn" bindtap="editProfile">编辑资料</view>
        <view class="settings-btn" bindtap="goToSettings">
          <image src="/images/set.png" class="settings-icon"></image>
        </view>
      </view>
    </view>
    
    <!-- 数据统计 -->
    <view class="stats">
      <view class="stat-item" bindtap="showPosts">
        <text class="stat-number">8</text>
        <text class="stat-label">发帖</text>
      </view>
      <view class="stat-item" bindtap="showLikes">
        <text class="stat-number">12</text>
        <text class="stat-label">获赞</text>
      </view>
      <view class="stat-item" bindtap="showFollowing">
        <text class="stat-number">24</text>
        <text class="stat-label">关注</text>
      </view>
      <view class="stat-item" bindtap="showFollowers">
        <text class="stat-number">18</text>
        <text class="stat-label">粉丝</text>
      </view>
    </view>
  </view>

  <!-- 核心功能菜单 -->
  <view class="core-menu">
    <view class="menu-grid">
      <view class="menu-item" bindtap="goToDrafts">
        <view class="menu-icon">
          <image src="/images/draft.png" class="menu-icon-img"></image>
        </view>
        <text class="menu-text">我的草稿</text>
      </view>
      <view class="menu-item" bindtap="goToTransactions">
        <view class="menu-icon">
          <image src="/images/Trade.png" class="menu-icon-img"></image>
        </view>
        <text class="menu-text">我的交易</text>
      </view>
    </view>
  </view>

  <!-- 内容区 -->
  <view class="content-section">
    <!-- 标签栏 -->
    <view class="tab-bar">
      <view class="tab-item {{activeTab === 'posts' ? 'active' : ''}}" bindtap="switchTab" data-tab="posts">发布</view>
      <view class="tab-item {{activeTab === 'collections' ? 'active' : ''}}" bindtap="switchTab" data-tab="collections">收藏</view>
      <view class="tab-item {{activeTab === 'likes' ? 'active' : ''}}" bindtap="switchTab" data-tab="likes">喜欢</view>
      <view class="search-btn" bindtap="searchContent">
        <image src="/images/search.png" class="search-icon"></image>
      </view>
    </view>
    
    <!-- 分类统计栏 -->
    <view class="category-stats" wx:if="{{activeTab === 'posts'}}">
      <view class="category-item">公开 11</view>
      <view class="category-item">私密 5</view>
      <view class="category-item">合集 0</view>
    </view>
    
    <!-- 帖子卡片 -->
    <view class="posts-container">
      <!-- 发布内容 -->
      <view class="post-card" wx:if="{{activeTab === 'posts'}}">
        <image src="/images/postings/VCG211333201276.jpg" class="post-image"></image>
        <view class="post-bottom">
          <view class="post-views">
            <image src="/images/eyes.png" class="views-icon"></image>
            <text class="views-count">549</text>
          </view>
          <view class="post-actions">
            <text class="post-author">旅行者小A</text>
            <view class="post-like" bindtap="toggleLike" data-id="post1">
              <image src="{{likes.post1 ? '/images/like_yes.png' : '/images/like_no.png'}}" class="like-icon"></image>
              <text class="like-count">28</text>
            </view>
          </view>
        </view>
      </view>
      
      <view class="post-card" wx:if="{{activeTab === 'posts'}}">
        <view class="post-text">
          <text class="post-content">在伦敦的第365天，分享一些旅行心得...</text>
        </view>
        <view class="post-bottom">
          <view class="post-views">
