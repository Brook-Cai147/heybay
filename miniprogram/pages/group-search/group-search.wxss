/* 全局样式 */
.group-search-container {
  width: 100%;
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f7ff 0%, #f8f9fa 100%);
}

/* 搜索框区域 */
.search-header {
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  padding: 20rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 2rpx 12rpx rgba(18, 150, 219, 0.08);
  position: sticky;
  top: 0;
  z-index: 100;
}

.search-input-box {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.search-icon {
  color: #1296db;
  margin-right: 10rpx;
}

.search-input {
  flex: 1;
  height: 60rpx;
  background: linear-gradient(135deg, #f5f7fa 0%, #e8f0fe 100%);
  border-radius: 30rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #2c3e50;
  border: 1rpx solid rgba(18, 150, 219, 0.1);
}

.search-input::placeholder {
  color: #7a8ba0;
}

.cancel-btn {
  font-size: 26rpx;
  color: #1296db;
  font-weight: 500;
  cursor: pointer;
  padding: 10rpx 15rpx;
}

/* 搜索历史 */
.search-history {
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(18, 150, 219, 0.1);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.history-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #2c3e50;
}

.clear-btn {
  font-size: 24rpx;
  color: #7a8ba0;
  cursor: pointer;
}

.history-list {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.history-item {
  background: linear-gradient(135deg, #f5f7fa 0%, #e8f0fe 100%);
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  cursor: pointer;
  transition: all 0.3s ease;
  border: 1rpx solid rgba(18, 150, 219, 0.1);
}

.history-item:hover {
  background: linear-gradient(135deg, #e8f0fe 0%, #d4e4fd 100%);
  box-shadow: 0 2rpx 8rpx rgba(18, 150, 219, 0.15);
}

.history-item text {
  font-size: 24rpx;
  color: #5a6c7d;
  font-weight: 500;
}

/* 本组热点内容 */
.group-hot-content {
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(18, 150, 219, 0.1);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 20rpx;
}

.hot-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.hot-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15rpx 0;
  border-bottom: 1rpx solid rgba(18, 150, 219, 0.08);
  cursor: pointer;
  transition: all 0.3s ease;
}

.hot-item:last-child {
  border-bottom: none;
}

.hot-item:hover {
  background: linear-gradient(135deg, #f5f7fa 0%, #e8f0fe 100%);
  border-radius: 8rpx;
  padding: 15rpx;
}

.hot-text {
  flex: 1;
  font-size: 26rpx;
  color: #2c3e50;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hot-icon {
  width: 40rpx;
  height: 40rpx;
  margin-left: 15rpx;
  border-radius: 8rpx;
}

/* 全组热搜榜 */
.hot-search-rank {
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(18, 150, 219, 0.1);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
}

.rank-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.rank-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
}

.rank-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #2c3e50;
}

.rank-list {
  display: flex;
  flex-direction: column;
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(18, 150, 219, 0.08);
  cursor: pointer;
  transition: all 0.3s ease;
}

.rank-item:last-child {
  border-bottom: none;
}

.rank-item:hover {
  background: linear-gradient(135deg, #f5f7fa 0%, #e8f0fe 100%);
  border-radius: 8rpx;
  padding: 18rpx 15rpx;
}

.rank-number {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #7a8ba0;
  margin-right: 20rpx;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #f5f7fa 0%, #e8f0fe 100%);
}

.rank-number.top-three {
  color: #ff6b6b;
  background: linear-gradient(135deg, #fff5f5 0%, #ffe0e0 100%);
}

.rank-keyword {
  flex: 1;
  font-size: 26rpx;
  color: #2c3e50;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-heat {
  font-size: 22rpx;
  color: #7a8ba0;
  font-weight: 500;
}

/* 搜索结果 */
.search-results {
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(18, 150, 219, 0.1);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
}

.result-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(18, 150, 219, 0.08);
  cursor: pointer;
  transition: all 0.3s ease;
}

.result-item:last-child {
  border-bottom: none;
}

.result-item:hover {
  background: linear-gradient(135deg, #f5f7fa 0%, #e8f0fe 100%);
  border-radius: 8rpx;
  padding: 20rpx 15rpx;
}

.result-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.result-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  border: 2rpx solid rgba(18, 150, 219, 0.2);
}

.result-nickname {
  font-size: 24rpx;
  color: #5a6c7d;
  font-weight: 500;
}

.result-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.result-content {
  font-size: 24rpx;
  color: #7a8ba0;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 无搜索结果 */
.no-result {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
}

.no-result-text {
  font-size: 28rpx;
  color: #7a8ba0;
}

/* 适配不同屏幕尺寸 */
@media (max-width: 375px) {
  .search-input {
    font-size: 24rpx;
  }
  
  .cancel-btn {
    font-size: 24rpx;
  }
  
  .history-title,
  .section-title,
  .rank-title {
    font-size: 24rpx;
  }
  
  .hot-text,
  .rank-keyword,
  .result-title {
    font-size: 24rpx;
  }
  
  .rank-number {
    width: 36rpx;
    height: 36rpx;
    font-size: 22rpx;
  }
}