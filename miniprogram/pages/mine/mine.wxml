<view class="page">
  <view class="card" wx:if="{{!user}}">
    <text class="card-title">还没有档案</text>
    <text class="card-tip">点一下就建档，用的是微信授权登录，不采集手机号</text>
    <button class="primary" bindtap="onLogin">登录 / 建档</button>
    <text class="err" wx:if="{{error}}">{{error}}</text>
  </view>

  <block wx:if="{{user}}">
    <view class="card">
      <text class="card-title">我的档案</text>
      <view class="row">
        <text class="label">昵称</text>
        <input class="input" value="{{nickName}}" placeholder="填个昵称" bindinput="onNickNameInput" />
        <text class="link" bindtap="onSaveNickName">保存</text>
      </view>
      <view class="row">
        <text class="label">信任档位</text>
        <text class="value">新面孔（信任分算法属 M2）</text>
      </view>
    </view>

    <view class="card">
      <text class="card-title">常驻城市</text>
      <view class="chips">
        <view
          class="chip {{user.city === item.value ? 'chip-on' : ''}}"
          wx:for="{{cityOptions}}"
          wx:key="value"
          data-value="{{item.value}}"
          bindtap="onPickCity"
        >{{item.label}}</view>
      </view>
      <text class="card-tip">M1 只开伦敦，其他城市显示"尚未开城"</text>
    </view>

    <view class="card">
      <text class="card-title">性别</text>
      <view class="chips">
        <view
          class="chip {{user.gender === item.value ? 'chip-on' : ''}}"
          wx:for="{{genderOptions}}"
          wx:key="value"
          data-value="{{item.value}}"
          bindtap="onPickGender"
        >{{item.label}}</view>
      </view>
      <text class="card-tip">
        性别只用于「仅同性响应」这个安全开关，不参与任何推荐或排序。留空则无法响应设了该开关的需求。
      </text>
      <text class="warn" wx:if="{{user.gender === 'unset'}}">当前未填写</text>
    </view>

    <view class="card">
      <text class="card-title">联系方式</text>
      <view class="chips">
        <view
          class="chip {{contactType === item.value ? 'chip-on' : ''}}"
          wx:for="{{contactTypeOptions}}"
          wx:key="value"
          data-value="{{item.value}}"
          bindtap="onPickContactType"
        >{{item.label}}</view>
      </view>
      <view class="row">
        <input
          class="input"
          value="{{contactValue}}"
          placeholder="填你希望对方怎么联系你"
          maxlength="60"
          bindinput="onContactInput"
        />
        <text class="link" bindtap="onSaveContact">保存</text>
      </view>
      <text class="card-tip">
        只有在双方达成共识（你选定了某个响应者）之后，才会把它下发给对方一个人。广场、响应列表、任何卡片里都不会出现。
      </text>
      <text class="warn" wx:if="{{!hasContact}}">还没填。没有联系方式，选定之后双方也约不上。</text>
      <text class="link danger" wx:if="{{hasContact}}" bindtap="onClearContact">清空联系方式</text>
    </view>

    <!-- 我参与过的单子：响应之后能找回来的唯一入口 -->
    <view class="card">
      <view class="seg">
        <view
          class="seg-item {{mineTab === 'responded' ? 'seg-on' : ''}}"
          data-tab="responded"
          bindtap="onSwitchTab"
        >我响应的（{{responded.length}}）</view>
        <view
          class="seg-item {{mineTab === 'published' ? 'seg-on' : ''}}"
          data-tab="published"
          bindtap="onSwitchTab"
        >我发布的（{{published.length}}）</view>
      </view>

      <text class="card-tip">过期、取消、已完成的单子也留在这里 —— 广场只挂在架的，这里是给你自己回看的。</text>
      <text class="card-tip" wx:if="{{listLoading}}">加载中…</text>

      <block wx:if="{{mineTab === 'responded'}}">
        <text class="card-tip" wx:if="{{!listLoading && responded.length === 0}}">
          还没响应过谁。去首页看看有没有能帮上的。
        </text>
        <view class="mine-item" wx:for="{{responded}}" wx:key="_id">
          <text class="mine-flag" wx:if="{{item.mySelected}}">你已被选定，去看联系方式</text>
          <request-card item="{{item}}" nowMs="{{nowMs}}" bindcardtap="onCardTap" />
        </view>
      </block>

      <block wx:if="{{mineTab === 'published'}}">
        <text class="card-tip" wx:if="{{!listLoading && published.length === 0}}">
          还没发过需求。有事就喊一声。
        </text>
        <request-card
          wx:for="{{published}}"
          wx:key="_id"
          item="{{item}}"
          nowMs="{{nowMs}}"
          bindcardtap="onCardTap"
        />
      </block>

      <text class="link" bindtap="goSquare">去需求广场</text>
    </view>

    <text class="err" wx:if="{{error}}">{{error}}</text>
  </block>
</view>
