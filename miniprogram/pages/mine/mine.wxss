.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 180rpx;
  background: #f7f8fa;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.card-tip {
  font-size: 24rpx;
  color: #999;
  line-height: 1.7;
  margin-top: 16rpx;
}

.row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.label {
  width: 160rpx;
  font-size: 28rpx;
  color: #666;
}

.value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.link {
  font-size: 26rpx;
  color: #1296db;
  padding-left: 16rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  padding: 12rpx 40rpx;
  margin: 8rpx 16rpx 8rpx 0;
  border-radius: 32rpx;
  background: #f2f3f5;
  font-size: 26rpx;
  color: #555;
}

.chip-on {
  background: #1296db;
  color: #fff;
}

.primary {
  margin-top: 24rpx;
  background: #1296db;
  color: #fff;
  font-size: 28rpx;
  border-radius: 44rpx;
}

.err {
  font-size: 24rpx;
  color: #e54d42;
  margin-top: 16rpx;
}

.warn {
  font-size: 24rpx;
  color: #f37b1d;
  margin-top: 12rpx;
}
