<view class="page">
  <view class="card">
    <text class="card-title">收到的邀请</text>
    <text class="tip" wx:if="{{loading}}">加载中…</text>
    <text class="tip" wx:if="{{!loading && !invites.length && !message}}">还没有人邀请你。别人给你发的定向邀请会出现在这里。</text>
    <text class="tip" wx:if="{{message}}">{{message}}</text>

    <view class="invite" wx:for="{{invites}}" wx:key="_id" data-id="{{item.requestId}}" bindtap="onOpenRequest">
      <view class="invite-head">
        <text class="category">{{item.categoryLabel}}</text>
        <text class="time">{{item.timeText}}</text>
      </view>
      <text class="text">{{item.text}}</text>
      <view class="invite-foot">
        <text class="req-title">{{item.requestTitle}}</text>
        <text class="tag" wx:if="{{item.respondedAt}}">你已响应</text>
      </view>
    </view>
  </view>

  <view class="card">
    <text class="tip">1v1 私信在 {{milestone}} 实现；订阅消息推送整块归 M4（D-30）。现在只有站内邀请。</text>
  </view>
</view>
