.page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f7f8fa;
  box-sizing: border-box;
}

.card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.card-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.tip {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #999;
}

.invite {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f2f3f5;
}

.invite-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.category {
  font-size: 22rpx;
  color: #1296db;
  background: #e8f4fd;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
}

.time {
  font-size: 22rpx;
  color: #bbb;
}

.text {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #333;
}

.invite-foot {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.req-title {
  flex: 1;
  font-size: 24rpx;
  color: #888;
}

.tag {
  font-size: 20rpx;
  color: #b26a00;
  background: #fff8e6;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}
