.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 200rpx;
  background: #f7f8fa;
  box-sizing: border-box;
}

/* 小螺入口（M2-13 / PRD 6.1）：做成一条低调的横条，不跟「帮我整理」抢主按钮的位置 */
.assistant-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  background: #e8f4fd;
  border-radius: 20rpx;
}

.assistant-entry-title {
  font-size: 26rpx;
  color: #1296db;
}

.assistant-entry-arrow {
  font-size: 32rpx;
  color: #1296db;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
}

/* 降级说明（M2-07）：用中性的灰而不是错误红 —— AI 没帮上忙不是故障（D-15） */
.card.degrade {
  background: #fafafa;
  border: 1rpx solid #eee;
}

.degrade-text {
  font-size: 26rpx;
  line-height: 1.6;
  color: #666;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 20rpx;
}

.card-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #999;
  line-height: 1.7;
}

.one-line {
  width: 100%;
  min-height: 140rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.7;
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.primary {
  margin-top: 24rpx;
  background: #1296db;
  color: #fff;
  font-size: 30rpx;
  border-radius: 44rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  padding: 12rpx 28rpx;
  margin: 8rpx 16rpx 8rpx 0;
  border-radius: 32rpx;
  background: #f2f3f5;
  font-size: 26rpx;
  color: #555;
}

.chip-on {
  background: #1296db;
  color: #fff;
}

.row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}

.label {
  width: 180rpx;
  font-size: 28rpx;
  color: #666;
}

.label.flex {
  flex: 1;
}

.input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  padding: 12rpx 0;
}

.area {
  width: 100%;
  min-height: 160rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.7;
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-top: 12rpx;
  box-sizing: border-box;
}

.mt {
  margin-top: 20rpx;
}

/* 金额 / 见面时间 / 见面地点：PRD 5.4 的用户专属字段，视觉上必须区别对待 */
.highlight {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #fff8e6;
  border: 1rpx solid #ffe0a3;
  display: flex;
  flex-direction: column;
}

.highlight.no-margin {
  margin-top: 0;
}

.hl-title {
  font-size: 26rpx;
  color: #b26a00;
  margin-bottom: 8rpx;
}

.picker {
  padding: 12rpx 24rpx;
  margin-right: 16rpx;
  background: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #333;
}

.expect {
  font-size: 24rpx;
  color: #888;
  line-height: 1.7;
}

.err {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #e54d42;
}

.hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #f37b1d;
}
