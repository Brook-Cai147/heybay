/* 全局样式 */
.home-container {
  width: 100%;
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f7ff 0%, #f8f9fa 100%);
  padding-bottom: 120rpx; /* 为TabBar留出空间 */
}

/* 顶部区域 */
.top-area {
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  padding: 15rpx 20rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 12rpx rgba(18, 150, 219, 0.08);
}

.top-content {
  display: flex;
  align-items: center;
  width: 100%;
}

.search-hot-container {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #f5f7fa 0%, #e8f0fe 100%);
  border-radius: 30rpx;
  padding: 12rpx 20rpx;
  cursor: pointer;
  border: 1rpx solid rgba(18, 150, 219, 0.1);
}

.search-icon {
  color: #1296db;
  margin-right: 10rpx;
}

.search-placeholder {
  flex: 1;
  font-size: 24rpx;
  color: #7a8ba0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hot-search {
  display: flex;
  align-items: center;
  cursor: pointer;
  white-space: nowrap;
  padding: 8rpx 12rpx;
  background: linear-gradient(135deg, #fff5f5 0%, #ffe0e0 100%);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 107, 107, 0.2);
}

.hot-icon-small {
  width: 24rpx;
  height: 24rpx;
  margin-right: 5rpx;
}

.hot-text {
  font-size: 24rpx;
  color: #ff6b6b;
  font-weight: 500;
}

/* 轮播/信息展示区 */
.banner-area {
  margin: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(18, 150, 219, 0.12);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
}

.banner-swiper {
  width: 100%;
  height: 300rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
}

/* 宫格导航区 */
.grid-nav-area {
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(18, 150, 219, 0.1);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
}

/* 一级分类导航 */
.nav-level1 {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.nav-level1-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  cursor: pointer;
  padding: 12rpx 0;
  position: relative;
  margin: 0 8rpx;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.nav-level1-item.active {
  background: linear-gradient(135deg, #e8f0fe 0%, #d4e4fd 100%);
}

.nav-level1-item.active::after {
  content: '';
  position: absolute;
  bottom: 4rpx;
  left: 20%;
  width: 60%;
  height: 4rpx;
  background: linear-gradient(90deg, #1296db 0%, #4db8e8 100%);
  border-radius: 2rpx;
}

.nav-level1-icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 8rpx;
}

.nav-level1-text {
  font-size: 24rpx;
  color: #5a6c7d;
  text-align: center;
  font-weight: 500;
}

.nav-level1-item.active .nav-level1-text {
  color: #1296db;
  font-weight: 600;
}

/* 二级分类导航 */
.nav-level2 {
  display: flex;
  white-space: nowrap;
  padding-bottom: 10rpx;
  overflow-x: scroll;
  overflow-y: hidden;
  -webkit-overflow-scrolling: touch;
}

.nav-level2::-webkit-scrollbar {
  display: none;
}

.nav-level2-item {
  background: linear-gradient(135deg, #f5f7fa 0%, #e8f0fe 100%);
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  margin-right: 15rpx;
  cursor: pointer;
  transition: all 0.3s ease;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 80rpx;
  text-align: center;
  border: 1rpx solid rgba(18, 150, 219, 0.1);
}

.nav-level2-item:hover {
  background: linear-gradient(135deg, #e8f0fe 0%, #d4e4fd 100%);
  transform: translateY(-2rpx);
  box-shadow: 0 2rpx 8rpx rgba(18, 150, 219, 0.15);
}

.nav-level2-text {
  font-size: 24rpx;
  color: #5a6c7d;
  line-height: 1;
  font-weight: 500;
}

.more-item {
  background: linear-gradient(135deg, #e8f0fe 0%, #d4e4fd 100%);
  border: 1rpx solid rgba(18, 150, 219, 0.2);
}

.more-item .nav-level2-text {
  color: #1296db;
  font-weight: 600;
}

/* 推荐内容信息流 */
.recommend-area {
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(18, 150, 219, 0.1);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  position: relative;
}

.recommend-header {
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid rgba(18, 150, 219, 0.1);
}

.recommend-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #2c3e50;
  position: relative;
  padding-left: 16rpx;
}

.recommend-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #1296db 0%, #4db8e8 100%);
  border-radius: 3rpx;
}

/* 筛选选项 */
.filter-options {
  display: flex;
  margin-bottom: 20rpx;
  padding: 15rpx 0;
  border-bottom: 1rpx solid rgba(18, 150, 219, 0.1);
  position: relative;
}

.filter-item {
  display: flex;
  align-items: center;
  margin-right: 40rpx;
  cursor: pointer;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #f5f7fa 0%, #e8f0fe 100%);
  position: relative;
  border: 1rpx solid rgba(18, 150, 219, 0.1);
  transition: all 0.3s ease;
}

.filter-item:hover {
  background: linear-gradient(135deg, #e8f0fe 0%, #d4e4fd 100%);
  box-shadow: 0 2rpx 8rpx rgba(18, 150, 219, 0.1);
}

.filter-text {
  font-size: 24rpx;
  color: #5a6c7d;
  margin-right: 5rpx;
  font-weight: 500;
}

.dropdown-arrow {
  font-size: 16rpx;
  color: #1296db;
  margin-left: 5rpx;
}

/* 排序下拉框 */
.sort-dropdown {
  position: absolute;
  top: 60rpx;
  right: 0;
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  border-radius: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(18, 150, 219, 0.15);
  z-index: 1000;
  width: 200rpx;
  border: 1rpx solid rgba(18, 150, 219, 0.1);
  overflow: hidden;
}

.sort-option {
  padding: 15rpx 20rpx;
  border-bottom: 1rpx solid rgba(18, 150, 219, 0.1);
  cursor: pointer;
  transition: all 0.2s ease;
}

.sort-option:last-child {
  border-bottom: none;
}

.sort-option.active {
  background: linear-gradient(135deg, #e8f0fe 0%, #d4e4fd 100%);
  color: #1296db;
  font-weight: 600;
}

.sort-option:hover {
  background: linear-gradient(135deg, #f5f7fa 0%, #e8f0fe 100%);
}

/* 帖子列表 */
.post-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 20rpx;
}

.post-item {
  padding: 24rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  border-radius: 12rpx;
  cursor: pointer;
  transition: all 0.3s ease;
  border: 1rpx solid rgba(18, 150, 219, 0.08);
  box-shadow: 0 2rpx 8rpx rgba(18, 150, 219, 0.05);
}

.post-item:hover {
  box-shadow: 0 4rpx 16rpx rgba(18, 150, 219, 0.12);
  transform: translateY(-2rpx);
  border-color: rgba(18, 150, 219, 0.15);
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.post-avatar {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  margin-right: 15rpx;
  border: 2rpx solid rgba(18, 150, 219, 0.2);
}

.post-nickname {
  font-size: 24rpx;
  font-weight: 500;
  color: #2c3e50;
}

.post-title {
  font-size: 26rpx;
  color: #2c3e50;
  line-height: 1.5;
  margin-bottom: 15rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-weight: 500;
}

.post-image {
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
  margin-bottom: 15rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.post-footer {
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

.post-like {
  display: flex;
  align-items: center;
  color: #7a8ba0;
  cursor: pointer;
  padding: 8rpx 16rpx;
  background: linear-gradient(135deg, #f5f7fa 0%, #e8f0fe 100%);
  border-radius: 20rpx;
  border: 1rpx solid rgba(18, 150, 219, 0.1);
  transition: all 0.2s ease;
}

.post-like:hover {
  background: linear-gradient(135deg, #ffe0e0 0%, #ffd0d0 100%);
  border-color: rgba(255, 107, 107, 0.2);
}

.like-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 5rpx;
}

.post-like-count {
  margin-left: 5rpx;
  font-size: 22rpx;
  font-weight: 500;
}

/* 适配不同屏幕尺寸 */
@media (max-width: 375px) {
  .banner-swiper {
    height: 250rpx;
  }
  
  .post-image {
    height: 250rpx;
  }
  
  .nav-level1-icon {
    width: 48rpx;
    height: 48rpx;
  }
  
  .nav-level1-text {
    font-size: 22rpx;
  }
  
  .nav-level1-item {
    margin: 0 5rpx;
  }
  
  .search-placeholder {
    font-size: 22rpx;
  }
  
  .hot-text {
    font-size: 22rpx;
  }
}

@media (min-width: 768px) {
  .banner-swiper {
    height: 400rpx;
  }
  
  .post-image {
    height: 400rpx;
  }
}