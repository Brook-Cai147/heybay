.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 180rpx;
  background: #f7f8fa;
  box-sizing: border-box;
}

.header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 8rpx 0 20rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.city {
  font-size: 26rpx;
  color: #666;
}

.filters {
  white-space: nowrap;
  margin-bottom: 12rpx;
}

.chip {
  display: inline-block;
  padding: 10rpx 26rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  background: #fff;
  font-size: 24rpx;
  color: #555;
}

.chip-on {
  background: #1296db;
  color: #fff;
}

.notice {
  margin: 40rpx 0;
  padding: 32rpx;
  background: #fff;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
}

.notice-title {
  font-size: 30rpx;
  color: #1a1a1a;
}

.notice-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.7;
}

.loading,
.more {
  padding: 32rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #999;
}

.empty {
  margin-top: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-title {
  font-size: 30rpx;
  color: #333;
}

.empty-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
  text-align: center;
}

.cta {
  margin-top: 40rpx;
  background: #1296db;
  color: #fff;
  font-size: 28rpx;
  border-radius: 44rpx;
  padding: 0 64rpx;
}

.err {
  margin: 16rpx 0;
  font-size: 24rpx;
  color: #e54d42;
}

/* 小螺悬浮球（M2-13 / PRD 6.1）：右下角固定，避开自定义 tabBar 的高度 */
.assistant-ball {
  position: fixed;
  right: 32rpx;
  bottom: 200rpx;
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1296db;
  border-radius: 52rpx;
  box-shadow: 0 6rpx 20rpx rgba(18, 150, 219, 0.35);
  z-index: 10;
}

.assistant-ball-text {
  font-size: 26rpx;
  color: #ffffff;
}
