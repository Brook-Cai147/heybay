.parse-card {
  margin: 0 0 24rpx;
  padding: 28rpx;
  background: #f2f8ff;
  border: 1rpx solid #cfe4ff;
  border-radius: 16rpx;
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.badge {
  padding: 4rpx 14rpx;
  font-size: 22rpx;
  color: #1296db;
  background: #e3f1fb;
  border-radius: 20rpx;
}

.summary {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #333;
}

.warn {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #d4691a;
}

.note {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #666;
}

.line {
  margin-top: 16rpx;
}

.line-label {
  font-size: 24rpx;
  color: #999;
}

.line-value {
  margin-left: 12rpx;
  font-size: 26rpx;
  color: #333;
}

.line-value.strong {
  color: #d4691a;
}

.tip {
  display: block;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #999;
}

.ghost {
  margin-top: 20rpx;
  color: #1296db;
  background: #fff;
  border: 1rpx solid #cfe4ff;
}
